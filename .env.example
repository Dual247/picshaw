# Template only. No project or key is configured by this file.
# Set the dedicated Picshaw project's HTTPS origin and sb_publishable_ key
# in an ignored .env.local only after project setup is approved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add service-role, secret keys, Google tokens or credentials here.

# Exact production HTTPS origin only (no path, port or wildcard).
# Must equal the reviewed isolated portal origin. Production Vercel deployments
# only: local and preview auth fail closed even if provider flags are enabled.
PIC_SHAW_AUTH_ORIGIN=https://app.picshaw.com
# Server-only switches. Enable individually only after secure provider setup
# and live staging verification. These flags do not configure Supabase providers.
PIC_SHAW_AUTH_GOOGLE_ENABLED=false
PIC_SHAW_AUTH_APPLE_ENABLED=false
PIC_SHAW_AUTH_EMAIL_ENABLED=false
# Session check/refresh, password update and logout are gated separately. Keep
# lifecycle available during a planned provider pause until sessions are revoked.
PIC_SHAW_AUTH_SESSION_ENABLED=false
# No flag can bypass the fail-closed distributed abuse-control adapter.
# Server-only admission credentials. Leave blank until provisioning is approved.
# Host must be the Dashboard transaction-pooler hostname for this project.
PIC_SHAW_ADMISSION_DB_HOST=
# Dedicated picshaw_admission role password, at least 32 characters.
PIC_SHAW_ADMISSION_DB_PASSWORD=
# 32 random bytes encoded as 64 lowercase hexadecimal characters.
PIC_SHAW_ADMISSION_HMAC_KEY=
# Never prefix these with NEXT_PUBLIC or commit actual credentials.
# VERCEL=1 and VERCEL_ENV=production must be supplied by Vercel itself;
# do not set them manually in local or preview environments.

# Private Google Search reports. Keep false until all hosted gates in
# docs/private-search-reports.md pass. Dedicated server-only RPC role, no service key.
PIC_SHAW_REPORTS_ENABLED=false
PIC_SHAW_REPORTS_DB_HOST=
PIC_SHAW_REPORTS_DB_PASSWORD=
